{
  "thinker_ckpt": "checkpoints/thinker_tiny",
  "audio_ckpt": "checkpoints/audio_enc_tiny",
  "vision_ckpt": "checkpoints/vision_tiny",
  "talker_ckpt": "checkpoints/talker_tiny",
  "ctx_len": 128,
  "lr": 5e-05,
  "wd": 0.01,
