{
  "save_dir": "checkpoints/vision_tiny",
  "train_manifest": "data/images/production_annotations.json",
  "image_root": "data/images",

  "seed": 42,
  "max_epochs": 50,
  "max_steps": 50000,

  "img_size": 224,
  "patch": 16,
  "d_model": 128,
  "n_layers": 4,
  "n_heads": 4,
  "d_ff": 512,
  "embed_dim": 128,
  "dropout": 0.1,

  "text_d_model": 128,
  "text_n_heads": 4,
  "text_n_layers": 4,
  "text_d_ff": 512,
  "text_max_len": 77,

  "use_thinker_for_text": false,
  "thinker_ckpt": "checkpoints/thinker_tiny",
  "thinker": {
    "vocab_size": 256,
    "n_layers": 4,
    "d_model": 128,
    "n_heads": 4,
    "d_ff": 512,
    "dropout": 0.05,
    "rope_theta": 10000,
    "use_gqa": false,
    "use_swiglu": true,
    "use_moe": false
  },

  "ctx_len": 77,
  "vocab_size": 256,

  "batch_size": 32,
  "gradient_accumulation_steps": 2,
  "num_workers": 2,
  "drop_last": true,

  "lr": 0.0005,
  "wd": 0.01,
  "warmup_steps": 100,
  "max_grad_norm": 1.0,

  "temperature": 0.07,

  "use_amp": true,
  "use_compile": false,
  "use_ema": true,
  "ema_decay": 0.999,

  "use_augmentation": false,
  "shuffle_buffer_size": 10000,

  "print_freq": 50,
  "checkpoint_freq": 1000,
  "val_freq": 100,
  "val_batches": 20,
  "val_batches_epoch_end": 50,
  "val_split": 0.1,

  "val_loss_threshold": 0.5,
  "use_lr_spike": false,
  "label_smoothing": 0.1
}
