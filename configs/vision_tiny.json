{
  "save_dir": "checkpoints/vision_tiny",
  "train_manifest": "data/images/production_annotations.json",
  "image_root": "data/images",
  
  "seed": 42,
  "max_epochs": 36,
  "max_steps": 320000,
  
  "img_size": 224,
  "patch": 16,
  "d_model": 192,
  "n_layers": 12,
  "n_heads": 3,
  "d_ff": 768,
  "embed_dim": 256,
  "dropout": 0.1,
  
  "text_d_model": 192,
  "text_n_heads": 3,
  "text_n_layers": 6,
  "text_d_ff": 768,
  "text_max_len": 77,
  
  "use_thinker_for_text": false,
  "thinker_ckpt": "checkpoints/thinker_tiny",
  "thinker": {
    "vocab_size": 32000,
    "n_layers": 4,
    "d_model": 256,
    "n_heads": 4,
    "d_ff": 1024,
    "dropout": 0.1,
    "rope_theta": 10000,
    "use_gqa": false,
    "use_swiglu": true,
    "use_moe": false
  },
  
  "ctx_len": 77,
  "vocab_size": 32000,
  
  "batch_size": 64,
  "gradient_accumulation_steps": 4,
  "num_workers": 1,
  "drop_last": true,
  
  "lr": 0.001,
  "wd": 0.01,
  "warmup_steps": 1000,
  "max_grad_norm": 0.5,
  
  "temperature": 0.3,
  
  "use_amp": true,
  "use_compile": false,
  "use_ema": true,
  "ema_decay": 0.999,
  
  "use_augmentation": true,
  "shuffle_buffer_size": 10000,
  
  "print_freq": 50,
  "checkpoint_freq": 5000,
  "val_freq": 100,
  "val_batches": 80,
  "val_batches_epoch_end": 150,
  "val_split": 0.1,
  
  "val_loss_threshold": 0.5,
  
  "use_lr_spike": true
}