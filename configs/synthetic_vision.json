{
  "save_dir": "checkpoints/vision_tiny",
  "train_manifest": "data/images/production_annotations.json",
  "image_root": "data/images/images",
  "seed": 42,
  "max_epochs": 30,
  "max_steps": 840,
  "img_size": 224,
  "patch": 16,
  "d_model": 128,
  "n_layers": 4,
  "n_heads": 4,
  "d_ff": 344,
  "embed_dim": 128,
  "dropout": 0.1,
  "text_d_model": 128,
  "text_n_heads": 4,
  "text_n_layers": 4,
  "text_d_ff": 512,
  "text_max_len": 77,
  "use_thinker_for_text": false,
  "thinker_ckpt": "checkpoints/thinker_tiny",
  "thinker": {
    "vocab_size": 256,
    "n_layers": 4,
    "d_model": 128,
    "n_heads": 4,
    "d_ff": 344,
    "dropout": 0.05,
    "rope_theta": 10000,
    "use_gqa": false,
    "use_swiglu": true,
    "use_moe": false
