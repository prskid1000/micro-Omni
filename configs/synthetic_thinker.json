{
  "vocab_size": 256,
  "n_layers": 4,
  "d_model": 128,
  "d_ff": 344,
  "n_heads": 4,
  "ctx_len": 64,
  "dropout": 0.05,
  "rope_theta": 10000,
  "use_gqa": true,
  "kv_groups": 2,
  "use_swiglu": true,
  "use_moe": false,
  "use_spiking": false,
  "use_ltc": false,

  "use_ema": true,
  "ema_decay": 0.999,

  "lr": 0.001,
  "wd": 0.0,
  "warmup_steps": 50,
  "max_steps": 1700,

  "batch_size": 32,
  "gradient_accumulation_steps": 1,

  "use_amp": true,
  "use_flash": true,
  "use_compile": false,

  "num_workers": 2,
  "drop_last": true,

  "print_freq": 50,
  "max_epochs": 30,

  "val_loss_threshold": 1.0,
  "val_split": 0.1,
  "val_freq": 100,
  "val_batches": 20,
  "val_batches_epoch_end": 50,

  "checkpoint_freq": 500,
  "max_grad_norm": 1.0,

  "seed": 42,
  "shuffle_buffer_size": 10000,

  "train_text": "data/text/production_corpus.txt",
  "save_dir": "checkpoints/thinker_tiny",

  "use_sentences": true,
  "ctx_len_sample_size": 100000,
  "ctx_len_percentile": 95.0,

  "use_early_stopping": false,
  "early_stopping_patience": 5,
  "early_stopping_min_delta": 0.001,
  "use_lr_spike": true,
  "lr_spike_multiplier": 5.0,
  "lr_spike_duration": 50,
  "lr_spike_consecutive_increases": 3
}
