{
  "vocab_size": 1024,
  "n_layers": 8,
  "d_model": 384,
  "d_ff": 1536,
  "n_heads": 6,
  "ctx_len": 256,
  "dropout": 0.1,
  "rope_theta": 10000,
  "use_gqa": true,
  "kv_groups": 3,
  "use_swiglu": true,
  "use_moe": false,
  "num_experts": 8,
  "num_experts_per_tok": 2,
  "use_spiking": false,
  "use_ltc": false,

  "use_ema": true,
  "ema_decay": 0.9995,

  "lr": 0.0006,
  "wd": 0.01,
  "warmup_steps": 200,
  "max_steps": 5000,

  "batch_size": 32,
  "gradient_accumulation_steps": 2,

  "use_amp": true,
  "use_flash": true,
  "use_compile": false,

  "num_workers": 2,
  "drop_last": true,

  "print_freq": 50,
  "max_epochs": 100,

  "val_loss_threshold": 0.1,
  "val_split": 0.1,
  "val_freq": 200,
  "val_batches": 20,
  "val_batches_epoch_end": 50,

  "checkpoint_freq": 1000,
  "max_grad_norm": 1.0,

  "seed": 42,
  "shuffle_buffer_size": 10000,

  "train_text": "data/text/production_corpus.txt",
  "save_dir": "checkpoints/thinker_tiny",

  "use_sentences": true,
  "ctx_len_sample_size": 100000,
  "ctx_len_percentile": 95.0,

  "use_lr_spike": true,
  "lr_spike_multiplier": 8.0,
  "lr_spike_duration": 150,
  "lr_spike_consecutive_increases": 2
}
