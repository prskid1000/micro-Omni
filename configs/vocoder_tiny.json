{
  "save_dir": "checkpoints/vocoder_tiny",
  "train_csv": "data/audio/production_tts.csv",
  "sample_rate": 16000,
  "n_mels": 128,
  "n_fft": 1024,
  "hop_length": 256,
  "batch_size": 1,
  "num_workers": 1,
  "drop_last": true,
  "max_audio_length_percentile": 50.0,
  "lr_g": 0.0002,
  "lr_d": 0.0002,
  "wd": 1e-6,
  "warmup_steps": 50,
  "max_steps": 5000,
  "max_epochs": 50,
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "use_amp": true,
  "use_compile": false,
  "lambda_mel": 45.0,
  "lambda_fm": 2.0,
  "lambda_adv": 1.0,
  "mel_weight_decay_start": 1000,
  "mel_weight_decay_duration": 2000,
  "mel_weight_decay_factor": 0.5,
  "discriminator_update_interval": 2,
  "discriminator_lr_warmup_steps": 500,
  "val_loss_threshold": 3.0,
  "val_split": 0.1,
  "print_freq": 50,
  "checkpoint_freq": 1000,
  "val_freq": 100,
  "val_batches": 20,
  "val_batches_epoch_end": 50,
  "seed": 42,
  "shuffle_buffer_size": 1000,
  "use_ema": true,
  "ema_decay": 0.999,
  "upsample_initial_channel": 256,
  "resblock_kernel_sizes": [3, 5, 7],
  "resblock_dilation_sizes": [
    [1, 2],
    [1, 2],
    [1, 2]
  ],
  "mpd_periods": [2, 3, 5],
  "mpd_kernel_size": 3,
  "mpd_stride": 2,
  "msd_num_scales": 2,
  "use_lr_spike": true,
  "lr_spike_multiplier": 10.0,
  "lr_spike_duration": 100,
  "lr_spike_consecutive_increases": 2
}
