{
  "vocab_size": 256,
  "n_layers": 4,
  "d_model": 128,
  "d_ff": 512,
  "n_heads": 4,
  "ctx_len": 64,
  "dropout": 0.05,
  "label_smoothing": 0.1,
  "rope_theta": 10000,
  "rope_scaling_factor": 1.0,
  "use_gqa": false,
  "use_swiglu": true,
  "use_moe": false,
  "use_spiking": false,
  "use_ltc": false,

  "use_ema": false,

  "lr": 0.003,
  "wd": 0.0,
  "warmup_steps": 20,
  "max_steps": 500000,

  "batch_size": 8,
  "gradient_accumulation_steps": 1,

  "use_amp": true,
  "use_flash": true,
  "use_compile": false,

  "num_workers": 2,
  "drop_last": true,

  "print_freq": 100,
  "max_epochs": 500,

  "val_loss_threshold": 0.1,
  "val_split": 0.05,
  "val_freq": 500,
  "val_batches": 50,
  "val_batches_epoch_end": 100,

  "checkpoint_freq": 5000,
  "max_grad_norm": 1.0,

  "seed": 42,
  "shuffle_buffer_size": 10000,

  "train_text": "data/text/production_corpus.txt",
  "save_dir": "checkpoints/thinker_tiny",

  "use_sentences": true,
  "ctx_len_sample_size": 100000,
  "ctx_len_percentile": 99.0,

  "use_lr_spike": false,
  "use_mtp": true
}
